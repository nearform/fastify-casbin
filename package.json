{
  "name": "fastify-casbin",
  "version": "4.0.0",
  "description": "Plugin for fastify to add generic support for Casbin",
  "type": "module",
  "main": "index.js",
  "types": "types/index.d.ts",
  "scripts": {
    "test": "node --test && npm run typescript",
    "lint": "standard | snazzy",
    "lint:fix": "standard --fix | snazzy",
    "typescript": "tstyche"
  },
  "precommit": [
    "lint",
    "test"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/nearform/fastify-casbin.git"
  },
  "keywords": [
    "fastify",
    "casbin"
  ],
  "author": "Simone Busoli <simone.busoli@nearform.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nearform/fastify-casbin/issues"
  },
  "homepage": "https://github.com/nearform/fastify-casbin#readme",
  "dependencies": {
    "fastify-plugin": "^5.0.1"
  },
  "peerDependencies": {
    "casbin": ">=5.1.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "casbin": "^5.36.0",
    "fastify": "^5.1.0",
    "pre-commit": "^1.2.2",
    "snazzy": "^9.0.0",
    "standard": "^17.1.2",
    "tstyche": "^7.1.0",
    "typescript": "^5.7.2"
  }
}
